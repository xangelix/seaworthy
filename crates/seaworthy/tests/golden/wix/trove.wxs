<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Acme Trove" Manufacturer="Acme" Version="1.4.0" UpgradeCode="{2B4E6A80-1C3D-4F5E-8A7B-9C0D1E2F3A4B}" Scope="perUserOrMachine" Language="1033" Codepage="65001" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="Packs and unpacks Trove archives." Manufacturer="Acme" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[InstallDir]" After="CostFinalize" Sequence="execute" />

    <!-- The setup dialogs (a full-UI install only): seaworthy's own, text only; no event runs code. -->
    <UI>
      <TextStyle Id="SeaworthyText" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="SeaworthyTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="SeaworthyText" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />
      <Property Id="INSTALLSCOPE" Value="user" />
      <Dialog Id="SetupDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}[ProductName]" />
        <Control Id="LicenseText" Type="ScrollableText" X="15" Y="36" Width="340" Height="128" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(bindpath.tree)\Acme\Trove.rtf" />
        </Control>
        <Control Id="Accept" Type="CheckBox" X="15" Y="170" Width="340" Height="15" Property="LICENSEACCEPTED" CheckBoxValue="1" Text="I &amp;accept the terms of the license agreement" />
        <Control Id="Scope" Type="RadioButtonGroup" X="15" Y="191" Width="340" Height="34" Property="INSTALLSCOPE">
          <RadioButtonGroup Property="INSTALLSCOPE">
            <RadioButton Value="user" X="0" Y="0" Width="340" Height="15" Text="Install just for &amp;me" />
            <RadioButton Value="machine" X="0" Y="17" Width="340" Height="15" Text="Install for &amp;everyone on this computer (needs administrator rights)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Install" Default="yes" DisableCondition="LICENSEACCEPTED &lt;&gt; &quot;1&quot;" EnableCondition="LICENSEACCEPTED = &quot;1&quot;">
          <Publish Property="ALLUSERS" Value="2" Condition="1" Order="1" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="INSTALLSCOPE = &quot;user&quot;" Order="2" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="INSTALLSCOPE = &quot;machine&quot;" Order="3" />
          <Publish Event="EndDialog" Value="Return" Condition="LICENSEACCEPTED = &quot;1&quot;" Order="4" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" Order="1" />
        </Control>
      </Dialog>
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}[ProductName]" />
        <Control Id="ActionText" Type="Text" X="15" Y="60" Width="340" Height="15" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="15" Y="80" Width="340" Height="10" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" Default="yes" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" Order="1" />
        </Control>
      </Dialog>
      <Dialog Id="CancelDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return" Condition="1" Order="1" />
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" Order="1" />
        </Control>
        <Control Id="Text" Type="Text" X="15" Y="15" Width="230" Height="30" NoPrefix="yes" Text="Cancel the setup of [ProductName]?" />
      </Dialog>
      <Dialog Id="ExitDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="&amp;Finish" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Return" Condition="1" Order="1" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}[ProductName]" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="340" Height="30" NoPrefix="yes" Text="Setup has finished." />
      </Dialog>
      <Dialog Id="UserExitDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="&amp;Finish" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" Order="1" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}[ProductName]" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="340" Height="30" NoPrefix="yes" Text="Setup was cancelled: nothing was changed." />
      </Dialog>
      <Dialog Id="FatalErrorDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="&amp;Finish" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" Order="1" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}[ProductName]" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="340" Height="30" NoPrefix="yes" Text="Setup ended because of an error: nothing was changed." />
      </Dialog>
      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="[ProductName] Setup" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="240" Height="60" TabSkip="no" NoPrefix="yes" Text="Information text" />
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorAbort" Condition="1" Order="1" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel" Condition="1" Order="1" />
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore" Condition="1" Order="1" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="No">
          <Publish Event="EndDialog" Value="ErrorNo" Condition="1" Order="1" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk" Condition="1" Order="1" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Retry">
          <Publish Event="EndDialog" Value="ErrorRetry" Condition="1" Order="1" />
        </Control>
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Yes">
          <Publish Event="EndDialog" Value="ErrorYes" Condition="1" Order="1" />
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="[ProductName] Setup" KeepModeless="yes">
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="&amp;Retry" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Retry" Condition="1" Order="1" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="Ignore" Condition="1" Order="1" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="168" Y="243" Width="56" Height="17" Text="E&amp;xit">
          <Publish Event="EndDialog" Value="Exit" Condition="1" Order="1" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\SeaworthyTitle}Files in use" />
        <Control Id="Text" Type="Text" X="15" Y="36" Width="340" Height="30" NoPrefix="yes" Text="These applications use files Setup needs to change. Close them and choose Retry, or choose Ignore to go on (a restart may be needed)." />
        <Control Id="List" Type="ListBox" X="15" Y="72" Width="340" Height="150" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
      </Dialog>
      <InstallUISequence>
        <Custom Action="SetInstallScopeMachine" After="CostFinalize" Condition="ALLUSERS = 1" />
        <Show Dialog="SetupDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDlg" OnExit="success" />
        <Show Dialog="UserExitDlg" OnExit="cancel" />
        <Show Dialog="FatalErrorDlg" OnExit="error" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="ExitDlg" OnExit="success" />
        <Show Dialog="UserExitDlg" OnExit="cancel" />
        <Show Dialog="FatalErrorDlg" OnExit="error" />
      </AdminUISequence>
    </UI>
    <CustomAction Id="SetInstallScopeMachine" Property="INSTALLSCOPE" Value="machine" />
    <Icon Id="ProductIcon.ico" SourceFile="!(bindpath.tree)\Acme\Trove.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="ARPCONTACT" Value="Acme Packaging &lt;packages@example.com&gt;" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorDir" Name="Acme">
        <Directory Id="InstallDir" Name="Trove" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

