<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by seaworthy from seaworthy.toml: product console, ProductVersion 1.4.0.
  Build it with the pinned WiX:
    wix build -arch x64 -bindpath tree=<tree> -o <name>.msi <name>.wxs
  where <tree> is the Windows layout's staging tree. Don't edit: regenerate.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Acme Console" Manufacturer="Acme" Version="1.4.0" UpgradeCode="{0F1E2D3C-4B5A-4978-8A6B-5C4D3E2F1A0B}" Scope="perMachine" Language="1033" Codepage="65001" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="The Acme console." Manufacturer="Acme" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[InstallDir]" After="CostFinalize" Sequence="execute" />
    <Property Id="ARPCONTACT" Value="Acme Packaging &lt;pkg@acme.test&gt;" />
    <Property Id="ARPURLINFOABOUT" Value="https://acme.test" />

    <!-- The update policy default. First install or upgrade: UPDATES= from the command line, else the
         installed value, else seaworthy.toml's. Maintenance (repair), which a standard user can start: the
         installed value, else seaworthy.toml's; a command-line UPDATES= is ignored. Group Policy wins. -->
    <Property Id="SAVEDUPDATES">
      <RegistrySearch Id="SavedUpdatePolicy" Root="HKLM" Key="SOFTWARE\Acme\Console" Name="UpdatePolicy" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="UPDATES" Secure="yes" />
    <SetProperty Id="UPDATES" Action="SetUpdatesForMaintenance" Value="[SAVEDUPDATES]" After="AppSearch" Condition="Installed AND (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesDefaultForMaintenance" Value="notify" After="SetUpdatesForMaintenance" Condition="Installed AND NOT (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesFromInstalled" Value="[SAVEDUPDATES]" After="SetUpdatesDefaultForMaintenance" Condition="NOT Installed AND NOT UPDATES AND (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesDefault" Value="notify" After="SetUpdatesFromInstalled" Condition="NOT UPDATES" Sequence="both" />
    <Launch Condition="REMOVE = &quot;ALL&quot; OR UPDATES = &quot;auto&quot; OR UPDATES = &quot;notify&quot; OR UPDATES = &quot;off&quot;" Message="UPDATES must be auto, notify or off." />

    <!-- The machine's update server, optional. First install or upgrade: SERVER= from the command
         line, else the installed value. Maintenance (repair): the installed value; a command-line SERVER= is
         ignored. Written only when set; Group Policy's Server wins. The helper checks the URL itself. -->
    <Property Id="SAVEDSERVER">
      <RegistrySearch Id="SavedServer" Root="HKLM" Key="SOFTWARE\Acme\Console" Name="Server" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SERVER" Secure="yes" />
    <SetProperty Id="SERVER" Action="SetServerForMaintenance" Value="[SAVEDSERVER]" After="SetUpdatesDefault" Condition="Installed" Sequence="both" />
    <SetProperty Id="SERVER" Action="SetServerFromInstalled" Value="[SAVEDSERVER]" After="SetServerForMaintenance" Condition="NOT Installed AND NOT SERVER AND SAVEDSERVER" Sequence="both" />
    <Launch Condition="REMOVE = &quot;ALL&quot; OR NOT SERVER OR SERVER ~&lt;&lt; &quot;https://&quot;" Message="SERVER must be an https:// URL." />

    <StandardDirectory Id="System64Folder" />
    <!-- When this version's removal rolls back, the helper service comes back without its DACL. -->
    <CustomAction Id="HelperServiceDaclRollback" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; sdset acme-console-update D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPLORC;;;IU)" Execute="rollback" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="HelperServiceDaclRollback" Before="DeleteServices" Condition="Installed AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorDir" Name="Acme">
        <Directory Id="InstallDir" Name="Console" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataVendorDir" Name="Acme">
        <Directory Id="DataDir" Name="Console">
          <Directory Id="UpdatesDir" Name="updates" />
          <Directory Id="LogsDir" Name="logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Acme Console" AllowAbsent="no">
      <Component Id="c000_AcmeTool.exe" Directory="InstallDir" Bitness="always64">
        <File Id="f000_AcmeTool.exe" Source="!(bindpath.tree)\Acme\Console\AcmeTool.exe" KeyPath="yes" />
      </Component>
      <Component Id="c001_acme_core_x86_64_v3.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f001_acme_core_x86_64_v3.dll" Source="!(bindpath.tree)\Acme\Console\acme_core_x86-64-v3.dll" KeyPath="yes" />
      </Component>
      <Component Id="c002_acme_core_x86_64_v2.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f002_acme_core_x86_64_v2.dll" Source="!(bindpath.tree)\Acme\Console\acme_core_x86-64-v2.dll" KeyPath="yes" />
      </Component>
      <Component Id="c003_extra_1.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f003_extra_1.dll" Source="!(bindpath.tree)\Acme\Console\extra_1.dll" KeyPath="yes" />
      </Component>
      <Component Id="c004_AcmeToolUpdate.exe" Directory="InstallDir" Bitness="always64">
        <File Id="f004_AcmeToolUpdate.exe" Source="!(bindpath.tree)\Acme\Console\AcmeToolUpdate.exe" KeyPath="yes" />
        <ServiceInstall Id="HelperService" Name="acme-console-update" DisplayName="Acme Console updater" Description="Installs signed releases of Acme Console." Type="ownProcess" Start="demand" ErrorControl="normal" Vital="yes" Account="LocalSystem">
          <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPLORC;;;IU)" />
        </ServiceInstall>
        <ServiceControl Id="HelperServiceControl" Name="acme-console-update" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="LogsDir" Directory="LogsDir" Guid="{7635E50D-DFE5-86F7-80DA-45BD7C3D5E51}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>
      <Component Id="DataVendorDirAcl" Directory="DataVendorDir" Guid="{CF04A21F-5643-8A47-A51C-D0D2D506BCEB}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>
      <Component Id="DataDirAcl" Directory="DataDir" Guid="{DDC2D826-C209-8C54-A8DB-39B0997CE33E}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>
      <Component Id="UpdatesDir" Directory="UpdatesDir" Guid="{1331DF3E-AB63-89E4-ABFD-FB84D7273376}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>
      <Component Id="UpdatePolicyDefault" Directory="InstallDir" Guid="{38570791-36F0-8CE1-A5BC-FFED0A0226CD}" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Acme\Console" Name="UpdatePolicy" Type="string" Value="[UPDATES]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Acme\Console" Name="Release" Type="string" Value="1.4.0~rc.2-812" />
      </Component>
      <Component Id="UpdateServer" Directory="InstallDir" Guid="{683C861B-9E97-89CF-8CAF-BBD144E4886E}" Bitness="always64" Condition="SERVER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Acme\Console" Name="Server" Type="string" Value="[SERVER]" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
