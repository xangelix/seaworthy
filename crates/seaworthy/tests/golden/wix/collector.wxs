<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by seaworthy from seaworthy.toml: product collector, ProductVersion 1.4.0.
  Build it with the pinned WiX:
    wix build -arch x64 -bindpath tree=<tree> -o <name>.msi <name>.wxs
  where <tree> is the Windows layout's staging tree. Don't edit: regenerate.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Acme &amp; Co &quot;Field&quot; &lt;Collector&gt; !!(bind.secret) --- Edition" Manufacturer="Acme" Version="1.4.0" UpgradeCode="{BEB4BBAE-8DEE-8F72-8C5B-B890571CA352}" Scope="perMachine" Language="1033" Codepage="65001" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="Collects &lt;everything&gt; for Acme &amp; Co." Manufacturer="Acme" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[InstallDir]" After="CostFinalize" Sequence="execute" />
    <Property Id="ARPCONTACT" Value="Acme Packaging &lt;pkg@acme.test&gt;" />
    <Property Id="ARPURLINFOABOUT" Value="https://acme.test" />

    <!-- The update policy default. First install or upgrade: UPDATES= from the command line, else the
         installed value, else seaworthy.toml's. Maintenance (repair), which a standard user can start: the
         installed value, else seaworthy.toml's; a command-line UPDATES= is ignored. Group Policy wins. -->
    <Property Id="SAVEDUPDATES">
      <RegistrySearch Id="SavedUpdatePolicy" Root="HKLM" Key="SOFTWARE\Acme\Collector" Name="UpdatePolicy" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="UPDATES" Secure="yes" />
    <SetProperty Id="UPDATES" Action="SetUpdatesForMaintenance" Value="[SAVEDUPDATES]" After="AppSearch" Condition="Installed AND (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesDefaultForMaintenance" Value="auto" After="SetUpdatesForMaintenance" Condition="Installed AND NOT (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesFromInstalled" Value="[SAVEDUPDATES]" After="SetUpdatesDefaultForMaintenance" Condition="NOT Installed AND NOT UPDATES AND (SAVEDUPDATES = &quot;auto&quot; OR SAVEDUPDATES = &quot;notify&quot; OR SAVEDUPDATES = &quot;off&quot;)" Sequence="both" />
    <SetProperty Id="UPDATES" Action="SetUpdatesDefault" Value="auto" After="SetUpdatesFromInstalled" Condition="NOT UPDATES" Sequence="both" />
    <Launch Condition="REMOVE = &quot;ALL&quot; OR UPDATES = &quot;auto&quot; OR UPDATES = &quot;notify&quot; OR UPDATES = &quot;off&quot;" Message="UPDATES must be auto, notify or off." />

    <!-- The machine's update server, optional. First install or upgrade: SERVER= from the command
         line, else the installed value. Maintenance (repair): the installed value; a command-line SERVER= is
         ignored. Written only when set; Group Policy's Server wins. The helper checks the URL itself. -->
    <Property Id="SAVEDSERVER">
      <RegistrySearch Id="SavedServer" Root="HKLM" Key="SOFTWARE\Acme\Collector" Name="Server" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SERVER" Secure="yes" />
    <SetProperty Id="SERVER" Action="SetServerForMaintenance" Value="[SAVEDSERVER]" After="SetUpdatesDefault" Condition="Installed" Sequence="both" />
    <SetProperty Id="SERVER" Action="SetServerFromInstalled" Value="[SAVEDSERVER]" After="SetServerForMaintenance" Condition="NOT Installed AND NOT SERVER AND SAVEDSERVER" Sequence="both" />
    <Launch Condition="REMOVE = &quot;ALL&quot; OR NOT SERVER OR SERVER ~&lt;&lt; &quot;https://&quot;" Message="SERVER must be an https:// URL." />

    <StandardDirectory Id="System64Folder" />
    <!-- Recovery: sc.exe, as MsiServiceConfigFailureActions is documented broken.
         First install and upgrade only: never in a repair a standard user can start.
         Again when this version's removal rolls back: the service comes back without them. -->
    <CustomAction Id="ServiceRecovery" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; failure AcmeCollector reset= 86400 actions= restart/15000/restart/60000/restart/300000/restart/900000" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ServiceRecoveryOnErrorExit" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; failureflag AcmeCollector 1" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ServiceRecoveryRollback" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; failure AcmeCollector reset= 86400 actions= restart/15000/restart/60000/restart/300000/restart/900000" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ServiceRecoveryOnErrorExitRollback" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; failureflag AcmeCollector 1" Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- When this version's removal rolls back, the helper service comes back without its DACL. -->
    <CustomAction Id="HelperServiceDaclRollback" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; sdset AcmeCollector-update D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPLORC;;;SY)" Execute="rollback" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ServiceRecovery" After="InstallServices" Condition="NOT Installed AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="ServiceRecoveryOnErrorExit" After="ServiceRecovery" Condition="NOT Installed AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="ServiceRecoveryRollback" Before="DeleteServices" Condition="Installed AND REMOVE=&quot;ALL&quot;" />
      <Custom Action="ServiceRecoveryOnErrorExitRollback" Before="DeleteServices" Condition="Installed AND REMOVE=&quot;ALL&quot;" />
      <Custom Action="HelperServiceDaclRollback" Before="DeleteServices" Condition="Installed AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VendorDir" Name="Acme">
        <Directory Id="InstallDir" Name="Collector" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataVendorDir" Name="Acme">
        <Directory Id="DataDir" Name="Collector">
          <Directory Id="StateDir" Name="state" />
          <Directory Id="UpdatesDir" Name="updates" />
          <Directory Id="LogsDir" Name="logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Acme &amp; Co &quot;Field&quot; &lt;Collector&gt; !!(bind.secret) --- Edition" AllowAbsent="no">
      <Component Id="c000_AcmeTool.exe" Directory="InstallDir" Bitness="always64">
        <File Id="f000_AcmeTool.exe" Source="!(bindpath.tree)\Acme\Collector\AcmeTool.exe" KeyPath="yes" />
        <ServiceInstall Id="Service" Name="AcmeCollector" DisplayName="Acme &amp; Co &quot;Field&quot; &lt;Collector&gt; !!(bind.secret) --- Edition" Description="Collects &lt;everything&gt; for Acme &amp; Co." Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes" Account="LocalSystem" Arguments="service" />
        <ServiceControl Id="ServiceControl" Name="AcmeCollector" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="ServiceStart" Name="AcmeCollector" Start="install" Wait="no" />
      </Component>
      <Component Id="c001_acme_core_x86_64_v3.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f001_acme_core_x86_64_v3.dll" Source="!(bindpath.tree)\Acme\Collector\acme_core_x86-64-v3.dll" KeyPath="yes" />
      </Component>
      <Component Id="c002_acme_core_x86_64_v2.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f002_acme_core_x86_64_v2.dll" Source="!(bindpath.tree)\Acme\Collector\acme_core_x86-64-v2.dll" KeyPath="yes" />
      </Component>
      <Component Id="c003_extra_1.dll" Directory="InstallDir" Bitness="always64">
        <File Id="f003_extra_1.dll" Source="!(bindpath.tree)\Acme\Collector\extra_1.dll" KeyPath="yes" />
      </Component>
      <Component Id="c004_AcmeToolUpdate.exe" Directory="InstallDir" Bitness="always64">
        <File Id="f004_AcmeToolUpdate.exe" Source="!(bindpath.tree)\Acme\Collector\AcmeToolUpdate.exe" KeyPath="yes" />
        <ServiceInstall Id="HelperService" Name="AcmeCollector-update" DisplayName="Acme &amp; Co &quot;Field&quot; &lt;Collector&gt; !!(bind.secret) --- Edition updater" Description="Installs signed releases of Acme &amp; Co &quot;Field&quot; &lt;Collector&gt; !!(bind.secret) --- Edition." Type="ownProcess" Start="demand" ErrorControl="normal" Vital="yes" Account="LocalSystem">
          <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPLORC;;;SY)" />
        </ServiceInstall>
        <ServiceControl Id="HelperServiceControl" Name="AcmeCollector-update" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="InstallDirAcl" Directory="InstallDir" Guid="{62827423-EBB1-85B1-888A-3954F7575210}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
