      <Component Id="DataVendorDirAcl" Directory="DataVendorDir" Guid="{14ADDA7A-911D-821A-9E9C-1C98E7ABEDE2}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
