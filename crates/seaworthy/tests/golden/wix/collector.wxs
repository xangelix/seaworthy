      <Component Id="DataDirAcl" Directory="DataDir" Guid="{E316B1EA-2BB1-8CE7-9D0F-1BE487F3584E}" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;RC;;;OW)" />
