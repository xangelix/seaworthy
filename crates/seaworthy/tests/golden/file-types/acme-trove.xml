<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-acme-trove">
    <comment>Acme Trove archive</comment>
    <glob pattern="*.trove"/>
    <glob pattern="*.trv"/>
    <magic priority="50">
      <match type="string" offset="0" value="TROVE"/>
      <match type="string" offset="8" value="\x89\xa0\xff"/>
    </magic>
  </mime-type>
</mime-info>
